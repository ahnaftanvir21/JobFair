# Server
PORT=3000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=aiub_job_fair
# true only in development: creates/updates tables from entities automatically
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Auth (used by the Auth module)
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# Job fair
# Fair-wide cutoffs. Leave blank for no cutoff. Example: 2026-12-05T23:59:59+06:00
# Student: registration, applying, CV drops. Employer: registration, job posts, candidate criteria.
STUDENT_DEADLINE=
EMPLOYER_DEADLINE=
UPLOAD_DIR=uploads
