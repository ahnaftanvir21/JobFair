# Server
PORT=3000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=aiub_job_fair
# true for hosted databases such as Supabase (encrypted connection)
DB_SSL=false
# true only in development: creates/updates tables from entities automatically
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Auth (used by the Auth module)
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# Job fair
# Fair-wide cutoffs. Leave blank for no cutoff. Example: 2026-12-05T23:59:59+06:00
# Student: registration, applying, CV drops. Employer: registration, job posts, candidate criteria.
STUDENT_DEADLINE=
EMPLOYER_DEADLINE=
UPLOAD_DIR=uploads
# Supabase Storage for uploads (CVs, logos, pictures). When both are set, files are
# kept in a private bucket instead of UPLOAD_DIR, so they survive server restarts.
# Find them in Supabase: Project Settings -> API Keys. The key is secret; never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uploads

# Email (forgot password)
# Leave SMTP_HOST blank in development: emails are saved to MAIL_OUTBOX_DIR and printed in the server log.
# The fair sends from the Gmail account aiub.jobfair2026@gmail.com. Gmail needs a 16-letter
# App Password (https://myaccount.google.com/apppasswords), not the account's normal password.
# Never commit the real password; it belongs in .env only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=aiub.jobfair2026@gmail.com
SMTP_PASS=<16-letter Google App Password>
MAIL_FROM=AIUB Job Fair <aiub.jobfair2026@gmail.com>
MAIL_OUTBOX_DIR=mail-outbox
# Frontend page the reset link opens. It reads ?token= and calls POST /api/auth/reset-password.
RESET_PASSWORD_URL=http://localhost:5173/reset-password
